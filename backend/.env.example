# ============================================================
# Molslinjen IT Support Agent — Backend Environment Variables
# ============================================================
# Copy this file to backend/.env and fill in your values.
# NEVER commit .env to git.
# ============================================================


# ── Azure OpenAI (required for AI features) ─────────────────
# Create in: Azure Portal → Azure OpenAI resource → Keys and Endpoint
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_API_VERSION=2024-02-01

# Names of the deployments you created in Azure OpenAI Studio:
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small


# ── Azure AI Search (optional — enables semantic RAG search) ─
# Create in: Azure Portal → Azure AI Search resource
# Leave blank to use local markdown fallback (documents/ folder)
AZURE_SEARCH_ENDPOINT=https://<your-search>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX=helpdesk-kb


# ── FreshService (optional — enables real ticket creation) ───
# Find in: FreshService Admin → API → Your API Key
# Domain is the subdomain: <domain>.freshservice.com
FRESHSERVICE_DOMAIN=molslinjen
FRESHSERVICE_API_KEY=<your-freshservice-api-key>
FRESHSERVICE_DEFAULT_GROUP_ID=0


# ── Azure Table Storage (optional — persistent sessions) ─────
# Create in: Azure Portal → Storage Account → Access Keys
# Leave blank to use in-memory store (data lost on restart)
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_ACCOUNT_NAME=<your-storage-account>


# ── Azure AD Authentication (Phase 3 — not required now) ─────
AZURE_AD_TENANT_ID=<your-tenant-id>
AZURE_AD_CLIENT_ID=<your-client-id>


# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
# Development: http://localhost:5173
# Production:  https://<your-frontend>.azurewebsites.net
CORS_ORIGINS=["http://localhost:5173"]
