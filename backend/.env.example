# Azure AI Foundry
AZURE_FOUNDRY_ENDPOINT=https://your-foundry.openai.azure.com/
AZURE_FOUNDRY_KEY=your-api-key
AZURE_FOUNDRY_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_FOUNDRY_TRIAGE_DEPLOYMENT=gpt-5
AZURE_FOUNDRY_PREFILTER_DEPLOYMENT=gpt-5-nano
AZURE_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Search
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_KEY=your-search-key
AZURE_SEARCH_INDEX=it-knowledge

# Azure Table Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount

# FreshService
FRESHSERVICE_DOMAIN=molslinjen.freshservice.com
FRESHSERVICE_API_KEY=your-freshservice-api-key
FRESHSERVICE_DEFAULT_GROUP_ID=12345

# Azure AD (for token validation)
AZURE_AD_TENANT_ID=your-tenant-id
AZURE_AD_CLIENT_ID=your-client-id

# Microsoft Graph
GRAPH_CLIENT_ID=your-graph-client-id
GRAPH_CLIENT_SECRET=your-graph-client-secret
GRAPH_TENANT_ID=your-tenant-id

# App Configuration
CONFIDENCE_THRESHOLD_HIGH=0.80
CONFIDENCE_THRESHOLD_LOW=0.40
MAX_CONVERSATION_TURNS=10
CORS_ORIGINS=["http://localhost:5173"]
